#!/bin/bash
# Worker-pane tmux guard: refuses kill-server/kill-session/kill-pane (and -K) on the
# live amux tmux server. Installed to ~/.amux/worker-bin/tmux, which amux prepends to
# WORKER PANE PATHs only; the amux server never has this directory on its PATH.
# Everything else, and kills on an explicitly different -S/-L socket, execs the real
# tmux by absolute path (AMUX_REAL_TMUX, else /opt/homebrew/bin/tmux, /usr/local/bin/tmux,
# /usr/bin/tmux). Exit 1 on refusal; 127 when no real tmux can be found.

set -u
set -f  # no globbing when splitting nested command text

die_missing() {
  printf 'tmux guard: %s\n' "$1" >&2
  exit 127
}

# Resolve the real tmux by absolute path. An explicit AMUX_REAL_TMUX never falls
# back: a test that names a fake must never reach a real server by accident.
if [ -n "${AMUX_REAL_TMUX:-}" ]; then
  REAL="$AMUX_REAL_TMUX"
  case "$REAL" in /*) ;; *) die_missing "AMUX_REAL_TMUX must be an absolute path (got '$REAL')" ;; esac
  [ -x "$REAL" ] || die_missing "AMUX_REAL_TMUX=$REAL is not executable"
else
  REAL=
  for cand in /opt/homebrew/bin/tmux /usr/local/bin/tmux /usr/bin/tmux; do
    if [ -x "$cand" ] && ! [ "$cand" -ef "$0" ]; then REAL="$cand"; break; fi
  done
  [ -n "$REAL" ] || die_missing "no real tmux found (set AMUX_REAL_TMUX to its absolute path)"
fi
if [ "$REAL" -ef "$0" ]; then
  die_missing "the real tmux resolves to this guard ($REAL); refusing to recurse"
fi

ARGV=("$@")

# --- global options -----------------------------------------------------------
# tmux [-2CDlNuVv] [-c shell-command] [-f file] [-L socket-name] [-S socket-path]
#      [-T features] [command ...]. Flags cluster (-2u, -uLname, -S/path).
sock_S=""; have_S=0
sock_L=""; have_L=0
have_K=0
shell_cmd=0
i=0
n=$#
while [ "$i" -lt "$n" ]; do
  a="${ARGV[$i]}"
  case "$a" in
    --) i=$((i + 1)); break ;;
    -?*) ;;
    *) break ;;
  esac
  j=1
  len=${#a}
  while [ "$j" -lt "$len" ]; do
    c="${a:$j:1}"
    case "$c" in
      c|f|L|S|T)
        rest="${a:$((j + 1))}"
        if [ -n "$rest" ]; then
          val="$rest"
        else
          i=$((i + 1))
          val="${ARGV[$i]:-}"
        fi
        case "$c" in
          S) sock_S="$val"; have_S=1 ;;
          L) sock_L="$val"; have_L=1 ;;
          c) shell_cmd=1 ;;
        esac
        j=$len
        ;;
      K) have_K=1; j=$((j + 1)) ;;
      *) j=$((j + 1)) ;;
    esac
  done
  i=$((i + 1))
done
cmd_start=$i

# -c runs a shell command (login-shell use), not a tmux command; any tmux it
# runs resolves through this guard again.
if [ "$shell_cmd" -eq 1 ]; then
  exec "$REAL" "$@"
fi

# --- is the target the live server? --------------------------------------------
uid="$(id -u 2>/dev/null || echo 0)"
live_sock="${TMUX:-}"
live_sock="${live_sock%%,*}"
default_real="/tmp/tmux-$uid/default"
default_env="${TMUX_TMPDIR:-/tmp}/tmux-$uid/default"

same_path() {
  # $1 vs $2: identical text, or the same existing file (sockets included).
  [ -n "$2" ] || return 1
  [ "$1" = "$2" ] && return 0
  [ -e "$1" ] && [ -e "$2" ] && [ "$1" -ef "$2" ] && return 0
  return 1
}

target_is_live() {
  local t
  if [ "$have_S" -eq 1 ]; then
    t="$sock_S"
  elif [ "$have_L" -eq 1 ]; then
    [ "$sock_L" = "default" ] && return 0
    t="${TMUX_TMPDIR:-/tmp}/tmux-$uid/$sock_L"
  else
    return 0
  fi
  same_path "$t" "$live_sock" && return 0
  same_path "$t" "$default_real" && return 0
  same_path "$t" "$default_env" && return 0
  return 1
}

# --- protected command names -----------------------------------------------------
# tmux accepts an exact name, an alias, or an unambiguous prefix. Refuse the
# kill-pane alias and every prefix of a protected name from "kill-p"/"kill-s" on
# (ambiguous ones like kill-se are rejected by tmux anyway).
is_protected_word() {
  local w="$1" name
  [ "$w" = "killp" ] && return 0
  [ "${#w}" -ge 6 ] || return 1
  for name in kill-server kill-session kill-pane; do
    case "$name" in "$w"*) return 0 ;; esac
  done
  return 1
}

refuse() {
  local why="$1" log_dir="${AMUX_HOME:-$HOME/.amux}/logs" joined
  printf -v joined '%q ' "${ARGV[@]}"
  joined="${joined% }"
  mkdir -p "$log_dir" 2>/dev/null
  printf '%s pwd=%q argv=%s reason=%q verdict=tmux_guard_refused\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PWD" "$joined" "$why" \
    >>"$log_dir/tmux-guard.log" 2>/dev/null
  cat >&2 <<EOF
tmux guard: refused '$why' on the LIVE amux tmux server (verdict=tmux_guard_refused).
Killing it ends every worker pane in the fleet. For a throwaway tmux, use a private
socket in a fresh environment, and let it end on its own:
  d=\$(mktemp -d); env -u TMUX -u TMUX_PANE TMUX_TMPDIR="\$d" tmux -S "\$d/sock" new-session -d 'sleep 3'
A kill on that explicit -S socket passes through:
  env -u TMUX -u TMUX_PANE tmux -S <your mktemp>/sock kill-server
EOF
  exit 1
}

if ! target_is_live; then
  exec "$REAL" "$@"
fi

[ "$have_K" -eq 1 ] && refuse "-K"

# Classify arguments by the interpreter that will run them. Aliases and unique
# prefixes are included; ordinary tmux arguments remain data.
command_kind() {
  local w="$1" name
  kind=""
  case "$w" in
    if) kind=if; return ;;
    run|new|neww|splitw|respawnp|respawnw|pipep|popup) kind=shell; return ;;
    confirm|bind|menu) kind=tmux; return ;;
  esac
  [ "${#w}" -ge 3 ] || return
  for name in run-shell new-session new-window split-window respawn-pane respawn-window pipe-pane display-popup; do
    case "$name" in "$w"*) kind=shell; return ;; esac
  done
  for name in bind-key confirm-before command-prompt display-menu set-hook; do
    case "$name" in "$w"*) kind=tmux; return ;; esac
  done
  case if-shell in "$w"*) kind=if ;; esac
}

# Inspect one shell simple command. The shell separators are handled below;
# only the program (also after an env wrapper) can make its arguments tmux options.
scan_simple_command() {
  local pos=0 w c val rest j inner_S="" inner_L="" inner_have_S=0 inner_have_L=0 inner_K=0
  local have_S have_L sock_S sock_L have_K
  [ "${#simple[@]}" -gt 0 ] || return
  while [ "$pos" -lt "${#simple[@]}" ]; do
    w="${simple[$pos]}"
    case "$w" in *=*) pos=$((pos + 1)) ;; *) break ;; esac
  done
  [ "$pos" -lt "${#simple[@]}" ] || return
  if [ "${simple[$pos]##*/}" = env ]; then
    pos=$((pos + 1))
    while [ "$pos" -lt "${#simple[@]}" ]; do
      w="${simple[$pos]}"
      case "$w" in
        -u|--unset|-C|--chdir|-S|--split-string) pos=$((pos + 2)) ;;
        -*) pos=$((pos + 1)) ;;
        *=*) pos=$((pos + 1)) ;;
        *) break ;;
      esac
    done
  fi
  [ "$pos" -lt "${#simple[@]}" ] || return
  [ "${simple[$pos]##*/}" = tmux ] || return
  pos=$((pos + 1))
  while [ "$pos" -lt "${#simple[@]}" ]; do
    w="${simple[$pos]}"
    case "$w" in
      --) pos=$((pos + 1)); break ;;
      -?*)
        j=1
        while [ "$j" -lt "${#w}" ]; do
          c="${w:j:1}"
          case "$c" in
            c|f|L|S|T)
              rest="${w:$((j + 1))}"
              val="$rest"
              if [ -z "$val" ]; then pos=$((pos + 1)); val="${simple[$pos]:-}"; fi
              if [ "$c" = S ]; then inner_S="$val"; inner_have_S=1; fi
              if [ "$c" = L ]; then inner_L="$val"; inner_have_L=1; fi
              break ;;
            K) inner_K=1 ;;
          esac
          j=$((j + 1))
        done ;;
      *) break ;;
    esac
    pos=$((pos + 1))
  done
  have_S=$inner_have_S; have_L=$inner_have_L; sock_S=$inner_S; sock_L=$inner_L; have_K=$inner_K
  target_is_live || return
  [ "$have_K" -eq 1 ] && refuse "nested -K"
  local expect_command=1
  while [ "$pos" -lt "${#simple[@]}" ]; do
    w="${simple[$pos]}"
    if [ "$w" = ';' ]; then
      expect_command=1
    elif [ "$expect_command" -eq 1 ]; then
      is_protected_word "$w" && refuse "$w (inside shell command)"
      expect_command=0
    fi
    pos=$((pos + 1))
  done
}

scan_shell_text() {
  local input="$1" ch next quote="" outer_quote="" in_backtick=0 word="" k
  local -a simple=()
  for ((k=0; k<${#input}; k++)); do
    ch="${input:k:1}"
    next="${input:k+1:1}"
    if [ "$quote" = "'" ]; then
      if [ "$ch" = "'" ]; then quote=""; else word+="$ch"; fi
      continue
    fi
    if [ "$ch" = "\\" ] && [ "$next" != "" ]; then
      k=$((k + 1)); word+="$next"; continue
    fi
    if [ "$ch" = '"' ]; then
      if [ "$quote" = '"' ]; then quote=""; else quote='"'; fi
      continue
    fi
    if [ "$quote" = "" ] && [ "$ch" = "'" ]; then quote="'"; continue; fi
    if [ "$ch" = '$' ] && [ "$next" = '(' ]; then
      [ -z "$word" ] || { simple+=("$word"); word=""; }
      scan_simple_command; simple=(); outer_quote="$quote"; quote=""; k=$((k + 1)); continue
    fi
    if [ "$ch" = ')' ] && [ -n "$outer_quote" ]; then
      [ -z "$word" ] || { simple+=("$word"); word=""; }
      scan_simple_command; simple=(); quote="$outer_quote"; outer_quote=""; continue
    fi
    if [ "$ch" = '`' ]; then
      [ -z "$word" ] || { simple+=("$word"); word=""; }
      scan_simple_command; simple=()
      if [ "$in_backtick" -eq 1 ]; then
        quote="$outer_quote"; outer_quote=""; in_backtick=0
      else
        outer_quote="$quote"; quote=""; in_backtick=1
      fi
      continue
    fi
    if [ "$quote" = '"' ]; then
      word+="$ch"; continue
    fi
    case "$ch" in
      ';'|'|'|'&'|'`'|'('|')'|'{'|'}'|$'\n')
        [ -z "$word" ] || { simple+=("$word"); word=""; }
        scan_simple_command; simple=() ;;
      ' '|$'\t'|'<'|'>')
        if [ "$quote" = "" ]; then
          [ -z "$word" ] || { simple+=("$word"); word=""; }
        else word+="$ch"; fi ;;
      *) word+="$ch" ;;
    esac
  done
  [ -z "$word" ] || simple+=("$word")
  scan_simple_command
}

scan_tmux_text() {
  local input="$1" ch quote="" first="" have_first=0 k
  for ((k=0; k<${#input}; k++)); do
    ch="${input:k:1}"
    if [ "$ch" = "\\" ] && [ "$quote" != "'" ]; then
      k=$((k + 1)); first+="${input:k:1}"; continue
    fi
    if [ "$ch" = "$quote" ] && [ -n "$quote" ]; then quote=""; continue; fi
    if [ -z "$quote" ]; then
      case "$ch" in
        "'"|'"') quote="$ch"; continue ;;
        ';') is_protected_word "$first" && refuse "$first (inside tmux command)"
             first=""; have_first=0; continue ;;
        ' '|$'\t'|$'\n')
          if [ -n "$first" ]; then have_first=1; fi
          continue ;;
      esac
    fi
    [ "$have_first" -eq 1 ] || first+="$ch"
  done
  is_protected_word "$first" && refuse "$first (inside tmux command)"
}

# --- command chain -----------------------------------------------------------------
# Commands separate on an argument ";" (shell \;) or one ending in an unescaped ";".
# The first word of each command is its name and is always checked.
expect_name=1
kind=""
skip_value=0
position=0
i=$cmd_start
while [ "$i" -lt "$n" ]; do
  a="${ARGV[$i]}"
  i=$((i + 1))
  sep_after=0
  if [ "$a" = ";" ]; then
    expect_name=1
    continue
  fi
  case "$a" in
    *\\\;) a="${a%\\;};" ;;
    *\;) a="${a%;}"; sep_after=1 ;;
  esac
  if [ "$expect_name" -eq 1 ]; then
    first="${a%%[[:space:]]*}"
    is_protected_word "$first" && refuse "$first"
    kind=""
    skip_value=0
    position=0
    names=0
    command_kind "$first"
    case "$first" in new|neww|new-*) names=1 ;; esac
    expect_name=0
  elif [ -n "$kind" ] && [ "$skip_value" -eq 1 ]; then
    skip_value=0                    # the value of a flag (-n name, -t target, -c dir): data
  elif [ -n "$kind" ] && [[ "$a" =~ ^-[A-Za-z]+$ ]]; then
    # Only the NAME of a new session or window (-n / -s) is skipped as data. Every other word is
    # scanned: guessing option arity per command once let `new-window -k 'tmux kill-server'`
    # through (-k takes no value), and over-refusing a word is safe where under-refusing is not.
    [ "$names" -eq 1 ] && case "${a: -1}" in n|s) skip_value=1 ;; esac
  elif [ -n "$kind" ]; then
    position=$((position + 1))
    case "$kind" in
      shell) scan_shell_text "$a" ;;
      tmux) scan_tmux_text "$a" ;;
      if) if [ "$position" -eq 1 ]; then scan_shell_text "$a"; else scan_tmux_text "$a"; fi ;;
    esac
  fi

  [ "$sep_after" -eq 1 ] && expect_name=1
done

exec "$REAL" "$@"
